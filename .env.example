# Set these in your hosting provider before building. Never use a service-role
# key for NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public business contact details. Include the country code, e.g. 90.
NEXT_PUBLIC_CONTACT_EMAIL=rojhat1maman@gmail.com
NEXT_PUBLIC_WHATSAPP_NUMBER=905454227919

# Public transfer details. Leave blank until the actual account is provided.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_IBAN=

# SERVER ONLY. Keep disabled until audited DB migrations and real bank sandbox
# tests pass. Existing PAYTR_* values are intentionally not read by this layer.
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_BASE_URL=
PAYMENT_CALLBACK_URL=https://nrsbequiteluminous.com/api/payment/callback
PAYMENT_3DS_RETURN_URL=https://nrsbequiteluminous.com/api/payment/return
SUPABASE_SERVICE_ROLE_KEY=
# Set true only after schema, transaction and RLS tests succeed in target DB.
PAYMENT_DATABASE_VERIFIED=false
# SERVER ONLY: manual orders remain disabled until reviewed migrations are applied.
# Configure ORDER_DATABASE_VERIFIED and SUPABASE_SERVICE_ROLE_KEY in the hosting
# project's server environment for the intended Preview/Production deployment.
# Enable only after target-project access and manual-order RPC permissions are
# verified. Never expose the service key as NEXT_PUBLIC_*; keep both payment
# flags false when enabling manual orders. No automatic activation on migration.
# Free Turkey shipping and total 7-10 business days are defined in delivery-policy.ts.
ORDER_DATABASE_VERIFIED=false
# Garanti BBVA adapter requires the bank-approved protocol and sandbox verification.
# Generic PAYMENT_API_* names are placeholders, not confirmed Garanti credential names.

# Garanti BBVA hosted 3DS sale. Server only; never copy TEST credentials to LIVE.
# PAYMENT_PROVIDER=garanti-oos only after target DB and bank tests are verified.
GARANTI_MODE=
GARANTI_TEST_SETUP_ONLY=
GARANTI_TEST_OBSERVATION_ONLY=
GARANTI_SITE_ORIGIN=
GARANTI_SUCCESS_URL=
GARANTI_ERROR_URL=
# Generate a random 32-byte hex value in the target secret manager.
GARANTI_HANDOFF_SECRET=
# Set true only after bank terminal/model permissions are confirmed.
GARANTI_OOS_VERIFIED=
GARANTI_LIVE_APPROVED=
# Record only full sandbox decline/cancel completion; this stays false for the
# controlled single-account live trial and does not enable broad customer access.
GARANTI_SANDBOX_PASSED=
GARANTI_LIVE_QUERY_FIELDS_CONFIRMED=false
GARANTI_TEST_DATABASE_ISOLATED=
GARANTI_TEST_SUPABASE_URL=
# Bank-confirmed single installment convention: empty string or 0.
GARANTI_SINGLE_INSTALLMENT=
# Exact bank-confirmed orderinq status/charge type values; no guessed defaults.
GARANTI_CAPTURED_STATUS=
GARANTI_CAPTURED_RESULT_CODE=
GARANTI_SALE_CHARGE_TYPE=
GARANTI_FINAL_FAILED_STATUSES=
GARANTI_TEST_MERCHANT_ID=
GARANTI_TEST_TERMINAL_ID=
GARANTI_TEST_USER_ID=
GARANTI_TEST_PROVISION_USER=
GARANTI_TEST_PROVISION_PASSWORD=
GARANTI_TEST_QUERY_USER=
GARANTI_TEST_QUERY_PASSWORD=
GARANTI_TEST_STORE_KEY=
GARANTI_TEST_FORM_URL=
GARANTI_TEST_QUERY_URL=
GARANTI_LIVE_MERCHANT_ID=
GARANTI_LIVE_TERMINAL_ID=
GARANTI_LIVE_USER_ID=
GARANTI_LIVE_PROVISION_USER=
GARANTI_LIVE_PROVISION_PASSWORD=
GARANTI_LIVE_QUERY_USER=
GARANTI_LIVE_QUERY_PASSWORD=
GARANTI_LIVE_STORE_KEY=
GARANTI_LIVE_FORM_URL=
GARANTI_LIVE_QUERY_URL=
# Production controlled trial: exact Supabase Auth user UUID and a cap in kuruş.
# These are server-only. The cap is at most 50000 (500 TRY); choose a lower
# ceiling matching the intended small test basket. Missing values keep live off.
GARANTI_LIVE_CONTROLLED_ONLY=false
GARANTI_LIVE_ALLOWED_USER_ID=
GARANTI_LIVE_MAX_AMOUNT_MINOR=
